---

<section id="geo-ai" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-card rounded-3xl p-8 md:p-12 border border-purple-500/20 bg-gradient-to-br from-purple-900/20 via-gray-900/40 to-blue-900/20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="px-3 py-1 rounded-md bg-purple-500/20 text-purple-300 text-xs font-bold uppercase tracking-widest border border-purple-500/30">
            Phase 5 GEO Engine Active
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 leading-tight">
            Built-in Generative Engine Optimization
          </h2>
          <p class="mt-4 text-gray-300 text-sm leading-relaxed">
            Our company profile automatically formats every article and product page with structural JSON-LD metadata, Flesch-Kincaid AI readability scoring, and entity extraction to rank at the top of AI Search responses.
          </p>

          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm shrink-0">✓</div>
              <div>
                <h4 class="text-white font-bold text-sm">Automated JSON-LD Schema</h4>
                <p class="text-gray-400 text-xs mt-0.5">Article & FAQPage schemas automatically injected for LLM parsers.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm shrink-0">✓</div>
              <div>
                <h4 class="text-white font-bold text-sm">Entity & Citation Recommendation</h4>
                <p class="text-gray-400 text-xs mt-0.5">Detects key entities and suggests authoritative citations to boost LLM confidence scores.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Score Card Preview -->
        <div class="glass-card rounded-2xl p-6 border border-gray-700 bg-gray-950/80">
          <div class="flex items-center justify-between border-b border-gray-800 pb-4 mb-6">
            <span class="text-sm font-bold text-gray-300">Wontent GEO Analyzer Result</span>
            <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold">LLM Readiness: High</span>
          </div>

          <div class="space-y-6">
            <div>
              <div class="flex justify-between text-xs font-bold text-gray-300 mb-2">
                <span>GEO Score</span>
                <span class="text-purple-400 font-extrabold">98 / 100</span>
              </div>
              <div class="w-full h-2 rounded-full bg-gray-800 overflow-hidden">
                <div class="h-full bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 w-[98%]"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-bold text-gray-300 mb-2">
                <span>Flesch AI Readability</span>
                <span class="text-blue-400 font-extrabold">85 / 100</span>
              </div>
              <div class="w-full h-2 rounded-full bg-gray-800 overflow-hidden">
                <div class="h-full bg-blue-500 w-[85%]"></div>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-gray-900/90 border border-gray-800 text-xs">
              <span class="text-gray-400 block font-semibold mb-1">Extracted Named Entities:</span>
              <div class="flex flex-wrap gap-2 mt-2">
                <span class="px-2 py-1 rounded bg-purple-500/20 text-purple-300 font-mono">Wontent Hub</span>
                <span class="px-2 py-1 rounded bg-blue-500/20 text-blue-300 font-mono">Astro 5.1</span>
                <span class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-300 font-mono">Elysia API</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
