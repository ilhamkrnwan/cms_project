---
---

<section class="relative pt-24 pb-20 md:pt-36 md:pb-32 overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/20 rounded-full blur-[140px] pointer-events-none animate-glow"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-blue-600/15 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <!-- Live Status Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card text-xs font-semibold text-purple-300 mb-8 border border-purple-500/30">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Managed dynamically by Wontent Content Hub API</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.15]">
      Architecting Next-Gen Digital <span class="gradient-text">Enterprise Solutions</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-gray-400 max-w-3xl mx-auto font-normal leading-relaxed">
      We build high-performance cloud applications, AI-driven content pipelines, and multi-platform enterprise ecosystems designed for scale and generative search readiness.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#articles" class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 shadow-xl shadow-purple-600/30 hover:shadow-purple-600/50 hover:scale-[1.02] transition-all">
        Explore Managed Content
      </a>
      <a href="http://localhost:5173" target="_blank" class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-gray-200 glass-card hover:bg-gray-800/80 transition-all border border-gray-700">
        Open Wontent CMS Dashboard →
      </a>
    </div>

    <!-- Trust Stats Bar -->
    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 glass-card p-8 rounded-2xl max-w-4xl mx-auto">
      <div>
        <div class="text-3xl font-extrabold text-white">99.99%</div>
        <div class="text-xs font-medium text-gray-400 mt-1">SLA Uptime Guarantee</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold gradient-text">10x</div>
        <div class="text-xs font-medium text-gray-400 mt-1">Faster Publishing Speed</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-white">100+</div>
        <div class="text-xs font-medium text-gray-400 mt-1">Active CMS Adapters</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-purple-400">GEO Ready</div>
        <div class="text-xs font-medium text-gray-400 mt-1">AI Search Optimized</div>
      </div>
    </div>
  </div>
</section>
