---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Wontent Web | Modern Content Ecosystem</title>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-[#0b0f19] text-gray-100 font-sans antialiased selection:bg-purple-500 selection:text-white flex flex-col justify-between">
		
		<!-- Navbar -->
		<header class="glass-nav sticky top-0 z-50 px-6 py-4 flex items-center justify-between max-w-7xl mx-auto w-full">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-500 to-purple-600 flex items-center justify-center text-white font-extrabold text-xl shadow-lg shadow-indigo-500/20">
					W
				</div>
				<span class="text-xl font-bold font-heading tracking-tight text-white">Wontent <span class="text-purple-400 font-normal">Web</span></span>
			</div>
			<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
				<a href="#features" class="hover:text-white transition-colors">Features</a>
				<a href="#architecture" class="hover:text-white transition-colors">Adapters</a>
				<a href="http://localhost:5173" class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold px-4 py-2 rounded-lg text-xs shadow-md shadow-purple-500/20 transition-all">
					Admin Dashboard &rarr;
				</a>
			</nav>
		</header>

		<!-- Hero Section -->
		<main class="flex-grow flex items-center justify-center px-6 py-20 relative">
			<div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
				<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass-card text-xs text-purple-300 border border-purple-500/20 shadow-inner">
					<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
					Connected to Wontent Content Hub Engine
				</div>
				
				<h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white font-heading leading-tight">
					Write Once. <br />
					<span class="gradient-text">Publish Everywhere.</span>
				</h1>
				
				<p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
					Wontent Content Hub distributes optimized content across Astro, Next.js, WordPress, and Social Channels seamlessly from a single unified hub.
				</p>

				<div class="flex flex-wrap items-center justify-center gap-4 pt-4">
					<a href="http://localhost:5173" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold px-6 py-3 rounded-xl text-sm shadow-xl shadow-purple-500/25 transition-all">
						Launch Admin Hub
					</a>
					<a href="http://localhost:3000/swagger" target="_blank" class="glass-card hover:bg-white/5 text-slate-300 font-medium px-6 py-3 rounded-xl text-sm transition-all">
						Explore API Specs &rarr;
					</a>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="border-t border-white/5 py-8 text-center text-xs text-slate-500">
			&copy; 2026 Wontent Content Hub. All rights reserved.
		</footer>

	</body>
</html>
