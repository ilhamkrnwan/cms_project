# Environment Configuration for Wontent Content Hub

# API Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
BETTER_AUTH_SECRET=wontent_super_secret_key_123456789

# Database Configuration (PostgreSQL)
POSTGRES_USER=wontent
POSTGRES_PASSWORD=wontentpass
POSTGRES_DB=wontent_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://wontent:wontentpass@localhost:5432/wontent_db

# MinIO S3 Storage
MINIO_ROOT_USER=wontentminio
MINIO_ROOT_PASSWORD=wontentminiopass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=wontentminio
S3_SECRET_KEY=wontentminiopass
S3_BUCKET=wontent-media

# Mailpit SMTP Server
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000
